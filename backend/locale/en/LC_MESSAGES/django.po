# Transactional cycle launch
msgid "L'identifiant local de l'unité est obligatoire."
msgstr "The unit local identifier is required."

msgid "Le nom de l'unité est obligatoire."
msgstr "The unit name is required."

msgid "L'unité de l'allocation est obligatoire."
msgstr "The allocation unit is required."

msgid "Chaque unité doit avoir un identifiant local unique."
msgstr "Each unit must have a unique local identifier."

msgid "Chaque unité doit avoir exactement une allocation."
msgstr "Each unit must have exactly one allocation."

msgid "Une allocation référence une unité inconnue."
msgstr "An allocation references an unknown unit."

msgid "L'espèce du plan doit correspondre à celle du cycle."
msgstr "The plan species must match the cycle species."

msgid "La somme des allocations doit correspondre à l'effectif initial du cycle."
msgstr "The allocation total must match the cycle initial fish count."

msgid "La capacité recommandée de l'unité est dépassée."
msgstr "The unit recommended capacity is exceeded."

msgid "Ce lancement existe déjà avec un contenu différent ou appartient à une autre ferme."
msgstr "This launch already exists with different content or belongs to another farm."

msgid "L'effectif courant du cycle ne correspond pas aux allocations."
msgstr "The cycle current fish count does not match its allocations."

msgid "Un nouveau cycle doit être lancé avec au moins une unité de production."
msgstr "A new cycle must be launched with at least one production unit."

msgid "Une unité existante ne peut pas contenir des champs de création."
msgstr "An existing unit cannot contain creation fields."

msgid "L'identifiant de l'unité existante est obligatoire."
msgstr "The existing production unit identifier is required."

msgid "Une nouvelle unité ne peut pas référencer une unité existante."
msgstr "A new unit cannot reference an existing production unit."

msgid "Une même unité ne peut être sélectionnée deux fois."
msgstr "The same production unit cannot be selected twice."

msgid "Le mode de lancement ne correspond pas à l'état de configuration de la ferme."
msgstr "The launch mode does not match the farm setup state."

msgid "Le plan de production est obligatoire pour le setup initial."
msgstr "The production plan is required for initial setup."

msgid "La configuration de la ferme est déjà terminée."
msgstr "The farm setup is already complete."

msgid "La ferme doit être configurée avant de lancer un cycle supplémentaire."
msgstr "The farm must be configured before launching an additional cycle."

msgid "L'unité de production sélectionnée est inactive."
msgstr "The selected production unit is inactive."

msgid "Cette unité de production est déjà utilisée par un autre cycle actif."
msgstr "This production unit is already assigned to another active cycle."

msgid "La capacité recommandée de l'unité de production est dépassée."
msgstr "The recommended capacity of the production unit has been exceeded."

msgid "La capacité de cette unité de production ne peut pas être déterminée."
msgstr "The capacity of this production unit cannot be determined."

